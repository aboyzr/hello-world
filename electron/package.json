{
  "name": "aboy-canbus",
  "productName": "Aboy Canbus",
  "version": "1.0.0",
  "description": "Baca, belajar dan hantar bingkai CAN kereta melalui dongle ELM327 (OBD2)",
  "main": "main.js",
  "author": "Aboy Workshop",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.aboy.canbus",
    "productName": "Aboy Canbus",
    "files": ["main.js", "preload.js", "canbus/**/*"],
    "win": {
      "target": ["portable", "nsis"]
    },
    "portable": {
      "artifactName": "AboyCanbus.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AboyCanbus-Setup.exe"
    }
  }
}
